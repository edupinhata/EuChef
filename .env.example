# Variáveis lidas automaticamente pelo Docker Compose.
# Os valores abaixo são exclusivos para desenvolvimento local.
# Use segredos fortes e um gerenciador de secrets fora do ambiente local.
POSTGRES_DB=meal_planner
POSTGRES_USER=meal_planner
POSTGRES_PASSWORD=meal_planner_local
POSTGRES_PORT=5433
BACKEND_PORT=8081
FRONTEND_PORT=5173
